# Optional — defaults to https://marketplace.agentivity.io if unset.
# Override for local development against a marketplace API running elsewhere
# (e.g. http://localhost:3001 while developing agentivity_marketplace).
MARKETPLACE_API_URL=https://marketplace.agentivity.io

# Optional — set to 1 to build and browse with the fake Templates of
# src/data/fixtures.ts instead of calling the API (offline work, tests).
# Never set it on a production build: the build stops if it is.
# MARKETPLACE_FIXTURES=1
